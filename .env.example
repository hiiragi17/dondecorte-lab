NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 公開サイトのURL（sitemap / canonical / OGP の絶対URL生成に使用）
# 例: https://dondecorte-lab.vercel.app
NEXT_PUBLIC_SITE_URL=

# Web Push（VAPID）。`npx web-push generate-vapid-keys` で一度だけ生成し、変更しない。
# 公開鍵はクライアントの購読処理で使うため NEXT_PUBLIC_ 接頭辞が必須。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 連絡先（mailto: または https:// のURL）
VAPID_SUBJECT=mailto:you@example.com
